// Cloudflare Workers config (10 §2/§6). Deploy: `npm run deploy`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prima-volta",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-25",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prima-volta",
			"database_id": "b2c1b934-80d2-4b32-860e-c98bdd6c75e6",
			"migrations_dir": "drizzle"
		}
	],
	"observability": {
		"enabled": true
	}
}